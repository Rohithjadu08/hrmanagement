# API Configuration
# For production (Vercel), point this to the deployed backend URL
# E.g. VITE_API_URL=https://hrmanagement-backend.onrender.com
# For local dev, leave this empty, Vite proxy will handle it
VITE_API_URL=

# Supabase Public Keys
# Safe to expose in the frontend
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
